# ── Backend selection ───────────────────────────────────────────────
# "deepseek" (default) or "local" (local DiffusionGemma via llama-diffusion-cli).
ABC_BACKEND=deepseek

# ── DeepSeek backend (ABC_BACKEND=deepseek) ─────────────────────────
DEEPSEEK_COORDINATOR_KEY=
DEEPSEEK_ROLE_A_KEY=
DEEPSEEK_ROLE_B_KEY=
DEEPSEEK_ROLE_C_KEY=
DEEPSEEK_ROLE_D_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ROLE_MODEL=deepseek-v4-pro

# ── Local DiffusionGemma backend (ABC_BACKEND=local) ────────────────
# No API keys needed. One llama-diffusion-cli process serves every role and the
# coordinator; roles run serially (snapshot-fair, identical to the parallel pool).
DG_BIN=/Users/vince/playground/llama.cpp/build/bin/llama-diffusion-cli
DG_MODEL=/Users/vince/playground/DiffusionGemma/diffusiongemma-26B-A4B-it-Q4_K_M.gguf
DG_NGL=99
DG_CTX=32768           # total context per call; >32768 may OOM the GPU on 48 GB
DG_COORD_MAX_N=3072    # max generated tokens for coordinator calls (compact/plan/report/summary)
DG_ROLE_MAX_N=1536     # max generated tokens per role statement; raise for more detail (slower)
# DG_TIMEOUT=1800      # per-call timeout (s)
# DG_EB_TMAX / DG_EB_TMIN  # optional entropy-bound sampler temperature overrides
