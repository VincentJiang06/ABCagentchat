# ── Backend selection ───────────────────────────────────────────────
# "deepseek" (default) or "local" (local DiffusionGemma via llama-diffusion-cli).
ABC_BACKEND=deepseek

# ── DeepSeek backend (ABC_BACKEND=deepseek) ─────────────────────────
DEEPSEEK_COORDINATOR_KEY=
DEEPSEEK_ROLE_A_KEY=
DEEPSEEK_ROLE_B_KEY=
DEEPSEEK_ROLE_C_KEY=
DEEPSEEK_ROLE_D_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ROLE_MODEL=deepseek-v4-pro

# ── Local DiffusionGemma backend (ABC_BACKEND=local) ────────────────
# No API keys needed. One llama-diffusion-cli process serves every role and the
# coordinator; roles run serially (snapshot-fair, identical to the parallel pool).
DG_BIN=/Users/vince/playground/llama.cpp/build/bin/llama-diffusion-cli
DG_MODEL=/Users/vince/playground/DiffusionGemma/diffusiongemma-26B-A4B-it-Q4_K_M.gguf
DG_NGL=99
# MEMORY: ubatch is the SOLE driver of peak GPU memory (measured on 48GB M4 Pro):
#   ubatch 4096 -> ~23GB | 6144 -> ~26GB | 8192 -> ~27GB. With ~14GB of other apps
#   open, 8192 hit ~42GB total -> swap. 4096 keeps the model ~23GB (<30GB), no swap.
DG_UBATCH_MAX=4096     # HARD cap. Prompts are auto-truncated to fit; do NOT raise on 48GB.
DG_CTX=6144            # context ceiling (prompt + generated tokens)
DG_COORD_MAX_N=1024    # coordinator generated tokens (memory-neutral; affects detail/speed)
DG_ROLE_MAX_N=768      # role statement generated tokens
DG_THREADS=1           # single-threaded (does NOT affect memory, only CPU/speed)
# DG_TIMEOUT=1800      # per-call timeout (s)
# DG_EB_TMAX / DG_EB_TMIN  # optional entropy-bound sampler temperature overrides
